    <!-- About App -->
    <string name="about_app_help_content_desc">About Penguin</string>
    <string name="about_app_title">About Penguin</string>
    <string name="about_app_subtitle">Share moments instantly with nearby friends without the hassle of manual sending.</string>
    <string name="about_feature_offline_title">100% Offline &amp; Direct</string>
    <string name="about_feature_offline_desc">Transfers directly device-to-device via Wi-Fi Direct and Bluetooth. Zero internet or mobile data needed.</string>
    <string name="about_feature_autoshare_title">Seamless Auto-Share</string>
    <string name="about_feature_autoshare_desc">When enabled, photos you snap on your camera are automatically synced with everyone in the room.</string>
    <string name="about_feature_privacy_title">5-Second Privacy Window</string>
    <string name="about_feature_privacy_desc">Each captured photo displays a 5-second alert so you can opt out or cancel before anything is shared.</string>
    <string name="about_feature_ephemeral_title">Private &amp; Account-Free</string>
    <string name="about_feature_ephemeral_desc">No cloud uploads, no account signups. Sessions are temporary and all data stays strictly on participant devices.</string>
