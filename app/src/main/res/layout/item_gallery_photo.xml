<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1:1 Aspect Ratio Photo Image -->
        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/shared_photos_title"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_penguin_logo" />

        <!-- Top Right Micro Sync Status Badge -->
        <FrameLayout
            android:id="@+id/badgeSyncContainer"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_photo_sync_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/viewSyncDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dot_synced" />

        </FrameLayout>

        <!-- Failed Retry Indicator Overlay -->
        <FrameLayout
            android:id="@+id/overlayRetry"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80181A1D"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivPhoto"
            app:layout_constraintEnd_toEndOf="@id/ivPhoto"
            app:layout_constraintStart_toStartOf="@id/ivPhoto"
            app:layout_constraintTop_toTopOf="@id/ivPhoto"
            tools:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/retry"
                android:src="@drawable/ic_refresh"
                app:tint="@color/status_failed" />
        </FrameLayout>

        <!-- Bottom Translucent Owner Tag -->
        <LinearLayout
            android:id="@+id/layoutOwnerTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/badge_bg"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            app:layout_constraintBottom_toBottomOf="@id/ivPhoto"
            app:layout_constraintEnd_toEndOf="@id/ivPhoto"
            app:layout_constraintStart_toStartOf="@id/ivPhoto">

            <TextView
                android:id="@+id/tvOwnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                tools:text="Alice" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
